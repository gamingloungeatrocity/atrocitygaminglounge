# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
KEEPALIVE_TOKEN=generate-a-long-random-token

# Supabase Configuration (NEVER expose SUPABASE_SECRET_KEY to the frontend!)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Cashfree Payment Gateway (Optional for online payments; verified server-to-server)
# Cashfree checkout is restricted to sandbox/test mode.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_URL=https://your-backend.example.com/api/payments/cashfree/webhook

# Initial Admin Seed Script (only used when running `npm run seed:admin`)
ADMIN_FULL_NAME=Lounge Administrator
ADMIN_EMAIL=admin@atrocitygaming.example
ADMIN_PASSWORD=ChangeThisStrongPassword123!
